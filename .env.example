# Copy to .env and fill in the credentials for the providers you use.
# Every variable below is optional at the platform level — only set the
# ones needed for the providers configured in your pipelines/agents.

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
MISTRAL_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434

# --- Reranking ---
COHERE_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ---
PINECONE_API_KEY=
QDRANT_API_KEY=
WEAVIATE_API_KEY=
WEAVIATE_URL=http://localhost:8080
CHROMA_API_KEY=

# --- OCR ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Speech-to-text ---
DEEPGRAM_API_KEY=

# --- Translation ---
DEEPL_AUTH_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# --- Image generation ---
MIDJOURNEY_API_KEY=
MIDJOURNEY_API_URL=

# --- Voice activity detection ---
PICOVOICE_ACCESS_KEY=

# --- Observability / tracing ---
# AGENT_PLATFORM_TRACING selects the backend: none | langsmith | langfuse
AGENT_PLATFORM_TRACING=none
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
