# Copy to .env and fill in the credentials for the providers you use.
# Every variable below is optional at the platform level — only set the
# ones needed for the providers configured in your pipelines/agents.

# --- LLM ---
# AGENT_PLATFORM_DEFAULT_LLM_MODEL is "<provider>:<model>"
# (config/settings.py::Settings, see core/config.py::parse_model_string).
# providers: openai | anthropic | mistral | ollama | huggingface
AGENT_PLATFORM_DEFAULT_LLM_MODEL=openai:gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
MISTRAL_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
# Read directly by the `ollama` SDK (not by integrations/credentials.py), auto-sent
# as a Bearer header. Only needed for Ollama Cloud or an auth-protected endpoint.
OLLAMA_API_KEY=

# --- Image generation ---
# AGENT_PLATFORM_DEFAULT_IMAGE_MODEL is "<provider>:<model>"
# providers: dalle | midjourney | stable_diffusion
AGENT_PLATFORM_DEFAULT_IMAGE_MODEL=dalle:dall-e-3
# dalle reuses OPENAI_API_KEY above; stable_diffusion runs locally, no key needed
MIDJOURNEY_API_KEY=
MIDJOURNEY_API_URL=http://localhost:8080

# --- Audio / speech-to-text ---
# AGENT_PLATFORM_DEFAULT_AUDIO_MODEL is "<provider>:<model>"
# providers: openai | deepgram | whisperx | faster_whisper
AGENT_PLATFORM_DEFAULT_AUDIO_MODEL=openai:whisper-1
# openai reuses OPENAI_API_KEY above; whisperx/faster_whisper run locally, no key needed
DEEPGRAM_API_KEY=

# --- Reranking ---
COHERE_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ---
PINECONE_API_KEY=
QDRANT_API_KEY=
WEAVIATE_API_KEY=
WEAVIATE_URL=http://localhost:8080
CHROMA_API_KEY=

# --- OCR / Translation (Google) ---
# Shared by AWS Textract OCR and Google Vision/Translate; a path to a
# service-account JSON file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Translation ---
DEEPL_AUTH_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# --- Voice activity detection ---
PICOVOICE_ACCESS_KEY=

# --- API server / agent (config/settings.py::Settings, AGENT_PLATFORM_ prefix) ---
AGENT_PLATFORM_AGENT_NAME=assistant
AGENT_PLATFORM_AGENT_SYSTEM_PROMPT=
AGENT_PLATFORM_MAX_ITERATIONS=10
# Most recent user turns kept in a conversation's history (older ones are dropped).
AGENT_PLATFORM_MAX_HISTORY_TURNS=20
AGENT_PLATFORM_LOG_LEVEL=INFO
AGENT_PLATFORM_API_HOST=127.0.0.1
AGENT_PLATFORM_API_PORT=8000
# Bearer keys accepted by /chat and /chat/stream, as a JSON list, e.g.
# ["key-one","key-two"]. Each key owns its own /chat conversations. The API
# refuses to start with no key unless auth is disabled below.
AGENT_PLATFORM_API_KEYS=[]
# true runs without authentication (local development only): all callers share
# one owner and one conversation cap, and /docs stays on.
AGENT_PLATFORM_API_AUTH_DISABLED=false
# Conversations each key keeps in memory (lost on restart, one process only);
# one more evicts that key's least recently used.
AGENT_PLATFORM_API_MAX_CONVERSATIONS_PER_KEY=100

# --- Observability / tracing (integrations/tracing/langfuse, requires the `tracing` extra) ---
# Tracing is on when both Langfuse keys are set, and a silent no-op otherwise.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to Langfuse Cloud (https://cloud.langfuse.com); set it for a
# self-hosted server or another region.
LANGFUSE_BASE_URL=
# langfuse | none. `none` disables tracing even when the keys are set.
AGENT_PLATFORM_TRACING_PROVIDER=langfuse
# Prompt and tool payloads are exported as size and digest only; set to true
# to also send their content to Langfuse.
AGENT_PLATFORM_CAPTURE_CONTENT=false
