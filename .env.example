# Copy to .env and fill in the credentials for the providers you use.
# Every variable below is optional at the platform level — only set the
# ones needed for the providers configured in your pipelines/agents.

# --- LLM ---
# AGENT_PLATFORM_DEFAULT_LLM_MODEL is "<provider>:<model>"
# (config/settings.py::Settings, see core/config.py::parse_model_string).
# providers: openai | anthropic | mistral | ollama | huggingface
AGENT_PLATFORM_DEFAULT_LLM_MODEL=openai:gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
MISTRAL_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
# Read directly by the `ollama` SDK (not by integrations/credentials.py), auto-sent
# as a Bearer header. Only needed for Ollama Cloud or an auth-protected endpoint.
OLLAMA_API_KEY=

# --- Image generation ---
# AGENT_PLATFORM_DEFAULT_IMAGE_MODEL is "<provider>:<model>"
# providers: dalle | midjourney | stable_diffusion
AGENT_PLATFORM_DEFAULT_IMAGE_MODEL=dalle:dall-e-3
# dalle reuses OPENAI_API_KEY above; stable_diffusion runs locally, no key needed
MIDJOURNEY_API_KEY=
MIDJOURNEY_API_URL=http://localhost:8080

# --- Audio / speech-to-text ---
# AGENT_PLATFORM_DEFAULT_AUDIO_MODEL is "<provider>:<model>"
# providers: openai | deepgram | whisperx | faster_whisper
AGENT_PLATFORM_DEFAULT_AUDIO_MODEL=openai:whisper-1
# openai reuses OPENAI_API_KEY above; whisperx/faster_whisper run locally, no key needed
DEEPGRAM_API_KEY=

# --- Reranking ---
COHERE_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ---
PINECONE_API_KEY=
QDRANT_API_KEY=
WEAVIATE_API_KEY=
WEAVIATE_URL=http://localhost:8080
CHROMA_API_KEY=

# --- OCR / Translation (Google) ---
# Shared by AWS Textract OCR and Google Vision/Translate; a path to a
# service-account JSON file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Translation ---
DEEPL_AUTH_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# --- Voice activity detection ---
PICOVOICE_ACCESS_KEY=

# --- API server / agent (config/settings.py::Settings, AGENT_PLATFORM_ prefix) ---
AGENT_PLATFORM_AGENT_NAME=assistant
AGENT_PLATFORM_AGENT_SYSTEM_PROMPT=
AGENT_PLATFORM_MAX_ITERATIONS=10
AGENT_PLATFORM_LOG_LEVEL=INFO
AGENT_PLATFORM_API_HOST=127.0.0.1
AGENT_PLATFORM_API_PORT=8000

# --- Observability / tracing (core/tracing.py, requires the `tracing` extra) ---
# Backend selector: auto | none | console. `auto` (default) exports over
# OTLP whenever OTEL_EXPORTER_OTLP_ENDPOINT (or _TRACES_ENDPOINT) is set,
# and is a safe no-op otherwise. `none` force-disables tracing even if an
# endpoint is set. `console` prints spans to stdout, no network needed.
AGENT_PLATFORM_TRACING=auto
AGENT_PLATFORM_SERVICE_NAME=agent-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# http/protobuf (default) or grpc; grpc needs the `tracing-grpc` extra.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Any OTLP-speaking backend works via the vars above (Honeycomb, Grafana
# Tempo/Cloud, Datadog, New Relic, SigNoz, LangSmith, Langfuse, a self-hosted
# OTel Collector, ...); example endpoint/header pairs for two of them:
#   LangSmith: OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
#              OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<key>,Langsmith-Project=<project>
#   Langfuse:  OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
#              OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
